# Active AI provider: bedrock or gemini
AI_PROVIDER=bedrock

# AWS Bedrock / Amazon Nova Lite
# Configure AWS credentials separately (for example with the AWS CLI).
# Do NOT commit access keys, bearer tokens, or other credentials to Git.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Gemini / Gemma 4 (used when AI_PROVIDER=gemini)
# Configure GEMINI_API_KEY separately; never commit the key.
GEMINI_MODEL=gemma-4-31b-it
GEMINI_FALLBACK_MODEL=gemma-4-26b-a4b-it

# API server
PORT=4000
HOST=0.0.0.0

# AdLens automated evidence refresh interval in milliseconds
# Default: 86400000 = 24 hours
ADLENS_REFRESH_INTERVAL_MS=86400000
